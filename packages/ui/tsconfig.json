{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "skipLibCheck": true,
    "strict": false,
    "paths": {
      "next": ["../../apps/web/node_modules/next"],
      "next/*": ["../../apps/web/node_modules/next/*"]
    }
  },
  "include": ["src/**/*"]
}
