{
  "name": "blih-ops",
  "version": "0.0.1",
  "private": true,
  "description": "Blih product monorepo — API, Auth, Skills, and Talent applications",
  "scripts": {
    "dev": "nx run-many -t dev --parallel=4",
    "start": "nx run-many -t start --parallel=4",
    "dev:api": "pnpm --filter @blih/api dev",
    "dev:auth": "pnpm --filter @blih/auth-web dev",
    "dev:skills": "pnpm --filter @blih/skills-web dev",
    "dev:talent": "pnpm --filter @blih/talent-web dev",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "prisma:migrate": "pnpm --filter @blih/api run prisma:migrate",
    "prisma:generate": "pnpm --filter @blih/api run prisma:generate",
    "seed": "pnpm --filter @blih/api run seed"
  },
  "devDependencies": {
    "nx": "^20.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
