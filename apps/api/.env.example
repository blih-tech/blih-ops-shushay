DATABASE_URL="postgresql://user:password@localhost:5432/blih_dev?schema=public"
JWT_SECRET="your-jwt-secret-here"
PORT=4000
CORS_ORIGINS="http://localhost:3001,http://localhost:3002,http://localhost:3003"
NODE_ENV=development
UPLOADS_BASE_URL="http://localhost:4000/uploads"

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Google OAuth ──────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Leave blank to disable Google sign-in (email/password login still works)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# The redirect URI registered in Google Cloud Console. Default works for localhost.
# GOOGLE_CALLBACK_URL=https://api.yourdomain.com/api/v1/auth/google/callback
# URL of the auth-web app (for error redirect fallback)
AUTH_URL=http://localhost:3003

# ── Chapa Payment Gateway ───────────────────────────────────────────────────
# Obtain secret key from Chapa Dashboard (Format: CHASECK_TEST-...)
CHAPA_SECRET_KEY=CHASECK_TEST-your-chapa-secret-key
CHAPA_API_URL=https://api.chapa.co/v1
SKILLS_WEB_URL=http://localhost:3001
API_URL=http://localhost:4000

# ── Chapa Test Mode Credentials Reference ──────────────────────────────────
# Test Mobile Money Numbers: 0900123456 | 0900112233 | 0900881111
# Test Card Number: 4111 1111 1111 1111 (Expiry: 12/28, CVV: 123)

